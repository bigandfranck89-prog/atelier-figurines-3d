      "id": "lire-actuel",
      "name": "Lire le fichier actuel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "jsCode": "// Fusionne le calendrier TMDB avec le fichier existant.\n// Règle : on ne touche JAMAIS aux notes, à la chronologie ni aux catégories\n// déjà saisies. On corrige les dates et on ajoute les titres inconnus.\n\nconst actuel = $('Lire le fichier actuel').first().json;\nconst items = actuel.items || [];\n\nconst films  = ($('TMDB — films à venir').first().json.results  || []);\nconst series = ($('TMDB — séries à venir').first().json.results || []);\n\nconst norm = s => (s || '')\n  .toLowerCase()\n  .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n  .replace(/[^a-z0-9]/g, '');\n\nconst index = new Map(items.map(i => [norm(i.t), i]));\n\nlet ajouts = 0, corrections = 0;\nconst journal = [];\n\nfunction traiter(entree, titre, date, kind) {\n  if (!titre || !date) return;\n  const cle = norm(titre);\n  const existant = index.get(cle);\n\n  if (existant) {\n    if (existant.d !== date) {\n      journal.push(`Date corrigée — ${existant.t} : ${existant.d} → ${date}`);\n      existant.d = date;\n      corrections++;\n    }\n  } else {\n    const nouveau = {\n      t: titre,\n      k: kind,\n      d: date,\n      m: kind === 'film' ? 'En salles' : 'Disney+',\n      n: 'Ajouté automatiquement depuis TMDB — à relire.'\n    };\n    items.push(nouveau);\n    index.set(cle, nouveau);\n    journal.push(`Nouveau titre — ${titre} (${date})`);\n    ajouts++;\n  }\n}\n\nfor (const f of films)  traiter(f, f.title, f.release_date, 'film');\nfor (const s of series) traiter(s, s.name,  s.first_air_date, 'serie');\n\nif (ajouts === 0 && corrections === 0) {\n  return [{ json: { modifie: false, resume: 'Aucun changement.' } }];\n}\n\nactuel.items = items;\nactuel.maj = new Date().toISOString().slice(0, 10);\nactuel.source = 'TMDB + manuel';\n\nreturn [{\n  json: {\n    modifie: true,\n    contenu: JSON.stringify(actuel, null, 1),\n    resume: `${ajouts} ajout(s), ${corrections} correction(s)`,\n    journal\n  }\n}];"
      },
      "id": "fusion",
      "name": "Fusionner sans écraser",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "conditions": {
